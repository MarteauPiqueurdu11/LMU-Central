# Cache local : contient le jeton d'authentification RaceOS et le profil du
# joueur. Ne doit jamais partir dans un depot.
.cache/

# Sauvegardes personnelles : macros, numeros de boutons d'un volant precis,
# reglages de controles, archives de code. Propres a une machine et a son
# proprietaire — et une configuration livree avec le programme s'installerait
# toute seule chez ceux qui le telechargent (voir docs/notes-techniques.md).
sauvegardes/

# Produits de compilation. L'executable est a la racine depuis la 1.0.2 : il
# pese 35 Mo, il se reconstruit d'un `py -3 build.py`, et c'est la Release
# GitHub qui le distribue.
build/
dist/
*.spec
/LMU Central.exe
/LMU-Central-v*.zip

# Donnees de l'application portable, ecrites a cote de l'executable : session,
# historique des ratings, configuration des molettes. Propres a une machine.
/donnees/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Divers
*.log
Thumbs.db
